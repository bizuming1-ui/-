# Copy to an untracked .env file on the server. Never commit real values.
ENVIRONMENT=development
APP_MODE=demo
APP_PUBLIC_URL=https://your-domain.example
APP_PASSWORD=
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
DATABASE_PATH=./data/quant.db

# Only for explicitly enabled Alpaca Paper mode. Never use Live credentials.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

STRATEGY_SYMBOLS=["SPY","QQQ","AAPL","MSFT","NVDA"]
FAST_WINDOW=20
SLOW_WINDOW=50
INITIAL_EQUITY=100000
PER_SYMBOL_FRACTION=0.10
MAX_GROSS_FRACTION=0.50
DAILY_LOSS_LIMIT_FRACTION=0.02
SLIPPAGE_BPS=5
COMMISSION_PER_ORDER=0
AUTO_RESUME=true
POLL_SECONDS=30

# 深圳 ETF 159502 单标的纸面模拟器（嘉实标普生物科技精选行业 ETF QDII）— 离线/Demo 优先
# 成本为可配置占位值，非真实费率；实时轮询默认关闭；Key 仅服务端环境变量
SZ159502_SYMBOL=159502.SZ
SZ159502_NAME=嘉实标普生物科技精选行业 ETF（QDII）
SZ159502_CURRENCY=CNY
SZ159502_MARKET=SZSE
SZ159502_TIMEZONE=Asia/Shanghai
SZ159502_INITIAL_EQUITY=100000
SZ159502_PER_TRADE_FRACTION=0.10
SZ159502_DAILY_LOSS_LIMIT_FRACTION=0.02
SZ159502_SLIPPAGE_BPS=5
SZ159502_COMMISSION_PER_ORDER=0
SZ159502_COST_NOTE=成本为可配置占位值，非真实费率，仅用于纸面演示
SZ159502_HAS_AUTHORIZED_5MIN_HISTORY=false

# 同花顺接口：仅从服务端环境变量 TONGHUASHUN_API_KEY 读取；前端/Notebook/GitHub 不得保存
# 历史基金接口为日线，高频分钟接口不应被假装为可用；未授权 5 分钟历史时不做真实回测
TONGHUASHUN_API_KEY=
TONGHUASHUN_ENABLED=false
SZ159502_POLL_ENABLED=false
SZ159502_POLL_SECONDS=60
