# Copy to an untracked .env file on the server. Never commit real values.
ENVIRONMENT=development
APP_MODE=demo
APP_PUBLIC_URL=https://your-domain.example
APP_PASSWORD=
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
DATABASE_PATH=./data/quant.db

# Only for explicitly enabled Alpaca Paper mode. Never use Live credentials.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

STRATEGY_SYMBOLS=["SPY","QQQ","AAPL","MSFT","NVDA"]
FAST_WINDOW=20
SLOW_WINDOW=50
INITIAL_EQUITY=100000
PER_SYMBOL_FRACTION=0.10
MAX_GROSS_FRACTION=0.50
DAILY_LOSS_LIMIT_FRACTION=0.02
SLIPPAGE_BPS=5
COMMISSION_PER_ORDER=0
AUTO_RESUME=true
POLL_SECONDS=30
